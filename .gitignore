# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Environments
venv/
.venv/
env/
ENV/

# PySpark / Delta / Java temporary logs
*.log
derby.log
metastore_db/
spark-warehouse/
.sparkStaging/

# IDE files
.vscode/
.idea/

# OS metadata
.DS_Store
Thumbs.db

# Data directories (avoid tracking local raw data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep